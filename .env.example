# Aynur 服务端配置示例。复制成 .env 或用系统环境变量注入。
# 没有任何 key 时会自动进入 demo 模式：全链路可跑，但内容来自脚本。

# auto = 有 LLM key 就走 live，否则 demo
AYNUR_MODE=auto

# 链路：A（直出维语）/ A'（直出 + 人设，默认）/ B1（专用翻译模型中转）/ B2（同一 LLM 自翻）
AYNUR_ARM=A'

# ---- 对话 LLM（OpenAI 兼容：DeepSeek / DashScope / SiliconFlow 都行）----
AYNUR_LLM_BASE_URL=https://api.deepseek.com/v1
AYNUR_LLM_API_KEY=
AYNUR_LLM_MODEL=deepseek-chat
AYNUR_LLM_TEMPERATURE=0.5

# ---- B1 臂专用翻译模型（可不填；留空则 B1 自动退回 B2）----
AYNUR_MT_BASE_URL=https://api.siliconflow.cn/v1
AYNUR_MT_API_KEY=
AYNUR_MT_MODEL=tencent/Hunyuan-MT-7B

# ---- 维语 ASR ----
# auto: 配了 aliyun 的 appkey/AK 就用阿里云 ISI，否则 mock
AYNUR_ASR_PROVIDER=auto
AYNUR_ASR_APPKEY=
AYNUR_ASR_ACCESS_KEY_ID=
AYNUR_ASR_ACCESS_KEY_SECRET=
AYNUR_ASR_REGION=cn-shanghai
# http: 自建/第三方 ASR，POST multipart 字段 audio，返回 {"text": "..."}
AYNUR_ASR_URL=
AYNUR_ASR_API_KEY=

# ---- 维语 TTS（目前最难的一环）----
# auto: 配了 AYNUR_TTS_VOICE_UG 就走 http，否则 edge（中文，仅演示用）
AYNUR_TTS_PROVIDER=auto
AYNUR_TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
AYNUR_TTS_VOICE_UG=
AYNUR_TTS_URL=
AYNUR_TTS_API_KEY=

# ---- 产品参数 ----
AYNUR_CITY=乌鲁木齐
AYNUR_USER_TITLE=ئاپا
AYNUR_USER_NAME=
AYNUR_DAILY_LIMIT=60
AYNUR_WEATHER=1

# 公网部署时给 /api/* 加一个口令，防止别人刷你的额度（留空则不校验）
AYNUR_ACCESS_TOKEN=
